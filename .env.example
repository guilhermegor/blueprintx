# Template for the git-ignored .env at the repo root (`*.env` in .gitignore).
# This does NOT feed CI — GitHub Actions cannot read this file. It is the
# reproducible SOURCE for re-provisioning this repo's Actions secrets after a
# machine loss, an expired token, or a rotated key: fill in real values in
# .env (never here), then `gh secret set <NAME> --body "$<NAME>"` per row.
# See CONTRIBUTING.md -> "Repository Secrets (Actions)" for the full table
# and the re-provisioning steps. Keep .env at mode 600.

# .github/workflows/coderabbit_trigger.yml, review_retry.yml,
# verify_branch_protection.yml. Fine-grained PAT, THIS REPOSITORY ONLY,
# `Pull requests: Read and write` — no other scope, and NOT `Issues: write`
# (measured 2026-09-10: this token 403s posting to an issue, 422 to a PR
# when the auth itself is fine; the workflow only ever comments on PRs).
# Must be a USER PAT, not GITHUB_TOKEN — CodeRabbit ignores bot comments.
GH_PAT_REVIEW_TRIGGER=KEY-GOES-HERE

# .github/workflows/scaffold_checks.yml (secret-scan job). GitGuardian API
# key (app.gitguardian.com -> API keys). Only feeds a human-authored PR run;
# a Dependabot-triggered run reads a separate secret store this repo has
# none of (blueprintx#457) and is skipped by design, not a scan that ran
# and found nothing.
GITGUARDIAN_API_KEY=KEY-GOES-HERE

# .github/workflows/release_apt.yml / release.yml. GPG key ID (short or long
# form) of the key below — `gpg --list-secret-keys --keyid-format long`.
APT_GPG_KEY_ID=KEY-GOES-HERE

# Passphrase for the private key below. Optional at the workflow level
# (secrets.APT_GPG_PASSPHRASE required: false) but required in practice for
# any key minted with a passphrase.
APT_GPG_PASSPHRASE=KEY-GOES-HERE

# ASCII-armored GPG private key that signs the APT repo
# (`gpg --export-secret-keys --armor <key-id>`). Multi-line: wrap the value
# in double quotes and paste the whole armored block exactly as gpg
# exported it, PGP header/footer markers included.
APT_GPG_PRIVATE_KEY=KEY-GOES-HERE
