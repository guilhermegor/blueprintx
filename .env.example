# Template for the git-ignored .env at the repo root (`*.env` in .gitignore).
# This does NOT feed CI: GitHub Actions cannot read this file. It is the
# reproducible SOURCE for re-provisioning this repo's Actions secrets. Fill in
# real values in .env (never here) and follow CONTRIBUTING.md -> "Repository
# Secrets (Actions)" for the table of consumers/scopes and the exact steps.
# Create it once with `[ -e .env ] || install -m 600 .env.example .env; chmod 600 .env`
# (stays private, never overwrites real values).

# Consumers: coderabbit_trigger.yml, review_retry.yml, verify_branch_protection.yml.
GH_PAT_REVIEW_TRIGGER=KEY-GOES-HERE

# Consumer: scaffold_checks.yml (secret-scan job).
GITGUARDIAN_API_KEY=KEY-GOES-HERE

# Consumers: release_apt.yml, release.yml.
APT_GPG_KEY_ID=KEY-GOES-HERE

# Leave empty if the key below has no passphrase, and skip its upload step;
# never keep placeholder text here. Wrap a real value in SINGLE quotes so
# `$` and backticks survive sourcing: put the whole value between '...'.
APT_GPG_PASSPHRASE=

# Multi-line armored key: keep the single quotes and paste the whole block,
# PGP header/footer included. Needs a bash-style `source`, not a strict parser.
APT_GPG_PRIVATE_KEY='KEY-GOES-HERE'

# Consumers: release_snap.yml (via release.yml). Contents of the file from
# `snapcraft export-login credentials.txt`; first-time setup is in
# .specs/features/snap-publishing/plan.md.
# Unset, the publish step exits 0 without uploading, so do not skip it.
SNAPCRAFT_STORE_CREDENTIALS='KEY-GOES-HERE'
