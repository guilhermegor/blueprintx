# Environment variables for the service
#
# SCOPE: this file is the UNION of six backends' keys, so at any moment most of it is INERT
# while still reading as live configuration. Every block below names the DB_BACKEND values
# that actually read it; anything outside that scope is ignored, not wrong.
#
# Nothing here is checked at commit time. This file is only the SEED: bin/ensure_env.sh copies
# it to .env on a fresh checkout and then never touches .env again, so a machine set up months
# ago still carries its day-one values no matter how far the code moved. Assume yours is stale,
# and re-read this file whenever the backend changes.

# --- always ---------------------------------------------------------------------------
# ENV: dev or prd (also development/production/produção/etc.; case/accent/space-insensitive)
ENV=development
APP_NAME=ddd-service-native-db

# --- always: engine selection ----------------------------------------------------------
# SQL-backed backends — for use with chassis.db_schema. Read by
# chassis.db_schema.application.database_factory.active_backend(), the single reader of this
# variable. It picks both the handler AND the SQL: queries are filed at
# src/config/queries/<DB_BACKEND>/, so this value chooses the dialect that gets loaded. A
# value with no matching directory fails at load and names the engines that do have one.
# Available options: sqlite, postgresql, mariadb, mysql, mssql, oracle
DB_BACKEND=sqlite

# --- DB_BACKEND=sqlite only -------------------------------------------------------------
DB_PATH=./data/app.db

# --- every backend EXCEPT sqlite ---------------------------------------------------------
# Set DB_DSN to skip the individual fields.
DB_USER=app_user
DB_PASSWORD=changeme
DB_HOST=localhost
DB_PORT=5432        # varies by backend: postgresql=5432, mysql/mariadb=3306, mssql=1433, oracle=1521
DB_NAME=app_db
DB_DSN=

# --- DB_BACKEND=postgresql only -----------------------------------------------------------
DB_SCHEMA=public

# --- DB_BACKEND=oracle only ---------------------------------------------------------------
# Service name replaces DB_NAME.
DB_SERVICE=XEPDB1

# --- DB_BACKEND=mssql only ------------------------------------------------------------------
# ODBC driver name used to build the pyodbc connection string.
DB_ODBC_DRIVER=ODBC Driver 17 for SQL Server

# --- only when docker-compose is included ---------------------------------------------------
# Database admin UI (pgAdmin / phpMyAdmin).
ADMIN_EMAIL=admin@app.local
ADMIN_PASSWORD=changeme
ADMIN_PORT=5050
