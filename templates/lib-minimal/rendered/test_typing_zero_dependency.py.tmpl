"""Smoke test: the dependency-free type_checker resolves in the wheel layout."""

from importlib import import_module
from typing import TYPE_CHECKING, Any, Literal, Protocol, TypedDict

import pytest

from ${PROJECT_PKG_NAME}._internal.utils.typing import TypeChecker, type_checker
from ${PROJECT_PKG_NAME}._internal.utils.typing.type_checker import _plain_class


if TYPE_CHECKING:
    from decimal import Decimal


str_module_path = "${PROJECT_PKG_NAME}._internal.utils.typing.type_checker"
checker_module = import_module(str_module_path)


@type_checker
def _add(a: int, *, b: int) -> int:
    """Add two ints — the decorated subject, defined at MODULE level.

    Nested inside the test it charged the test 1 for the nested ``def`` (tests/ is capped at
    complexity 1, ``bin/check_complexity.sh``) while adding nothing: the decorator is applied
    at definition time either way.

    Parameters
    ----------
    a : int
        First addend.
    b : int
        Second addend.

    Returns
    -------
    int
        The sum.
    """
    return a + b


def test_decorator_accepts_right_type() -> None:
    """The decorator lets a well-typed standalone call through."""
    assert _add(1, b=2) == 3


def test_decorator_rejects_wrong_type() -> None:
    """The decorator validates a standalone function's arguments."""
    with pytest.raises(TypeError):
        _add(1, b=2.0)  # type: ignore[arg-type]


@type_checker
def _total(*values: int) -> int:
    """Sum variadic ints.

    Parameters
    ----------
    *values : int
        Numbers to add.

    Returns
    -------
    int
        The sum.
    """
    return sum(values)


@type_checker
def _scale(factor: float) -> float:
    """Return ``factor`` unchanged.

    Parameters
    ----------
    factor : float
        A factor.

    Returns
    -------
    float
        The same factor.
    """
    return factor


def test_any_annotation_is_accept_anything() -> None:
    """``Any`` resolves to ``object`` instead of becoming an ``isinstance`` target."""
    assert _plain_class(Any) is object


def test_variadic_elements_are_checked_one_by_one() -> None:
    """``*args`` annotated ``int`` accepts ints."""
    assert _total(1, 2) == 3


def test_variadic_rejects_wrong_element() -> None:
    """A wrong element inside ``*args`` is rejected."""
    with pytest.raises(TypeError):
        _total(1, 2.5)  # type: ignore[arg-type]


def test_int_is_accepted_for_float() -> None:
    """PEP 484 widening: an int satisfies a ``float`` annotation."""
    assert _scale(1) == 1


def test_bool_is_rejected_for_int() -> None:
    """A bool is not accepted where ``int`` is annotated."""
    with pytest.raises(TypeError):
        _add(True, b=2)


def _identity(value: int) -> int:
    """Return ``value`` unchanged, left undecorated so a test can wrap it.

    Parameters
    ----------
    value : int
        A number.

    Returns
    -------
    int
        The same number.
    """
    return value


class _Shape(Protocol):
    """A Protocol that is not ``runtime_checkable``, so ``isinstance`` rejects it."""

    def area(self) -> int:
        """Return the area."""


class _Record(TypedDict):
    """A ``TypedDict``, which ``isinstance`` also rejects."""

    name: str


@type_checker
def _union(value: int | str) -> object:
    """Return ``value`` unchanged; the annotation is a union.

    Parameters
    ----------
    value : int | str
        A number or a string.

    Returns
    -------
    object
        The same value.
    """
    return value


@type_checker
def _optional(value: str | None) -> object:
    """Return ``value`` unchanged; the annotation is an Optional.

    Parameters
    ----------
    value : str | None
        A string or ``None``.

    Returns
    -------
    object
        The same value.
    """
    return value


@type_checker
def _generic(value: list[int]) -> object:
    """Return ``value`` unchanged; the annotation is a generic alias.

    Parameters
    ----------
    value : list[int]
        A list.

    Returns
    -------
    object
        The same value.
    """
    return value


@type_checker
def _unsupported(*, mode: Literal["a", "b"], values: dict[str, list[int]]) -> object:
    """Return ``mode``; ``Literal`` and container elements are not checked.

    Parameters
    ----------
    mode : Literal['a', 'b']
        A mode name.
    values : dict[str, list[int]]
        A nested container.

    Returns
    -------
    object
        The mode.
    """
    return mode


@type_checker
def _protocol_optional(value: _Shape | None) -> object:
    """Return ``value`` unchanged; the member cannot be used with ``isinstance``.

    Parameters
    ----------
    value : _Shape | None
        A Protocol member or ``None``.

    Returns
    -------
    object
        The same value.
    """
    return value


@type_checker
def _typeddict_optional(value: _Record | None) -> object:
    """Return ``value`` unchanged; the member cannot be used with ``isinstance``.

    Parameters
    ----------
    value : _Record | None
        A ``TypedDict`` member or ``None``.

    Returns
    -------
    object
        The same value.
    """
    return value


@type_checker
def _float_optional(value: float | None) -> object:
    """Return ``value`` unchanged; an ``int`` widens to ``float`` inside a union.

    Parameters
    ----------
    value : float | None
        A float or ``None``.

    Returns
    -------
    object
        The same value.
    """
    return value


@type_checker
def _generic_optional(value: list[int] | None) -> object:
    """Return ``value`` unchanged; a generic alias sits inside a union.

    Parameters
    ----------
    value : list[int] | None
        A list or ``None``.

    Returns
    -------
    object
        The same value.
    """
    return value


def _any_member_subject(value: object) -> object:
    """Return ``value`` unchanged; its annotation is swapped for a union with ``Any`` below.

    Parameters
    ----------
    value : object
        Anything.

    Returns
    -------
    object
        The same value.
    """
    return value


_any_member_subject.__annotations__["value"] = int | Any
_any_member = type_checker(_any_member_subject)


def test_union_accepts_each_member() -> None:
    """A union accepts a value of any of its member classes."""
    assert (_union(1), _union("a")) == (1, "a")


def test_union_rejects_non_member() -> None:
    """A union rejects a value matching none of its members."""
    with pytest.raises(TypeError, match=r"int \| str"):
        _union(1.5)  # type: ignore[arg-type]


def test_optional_accepts_none_and_member() -> None:
    """An Optional accepts ``None`` and its inner class."""
    assert (_optional(None), _optional("a")) == (None, "a")


def test_optional_rejects_non_member() -> None:
    """An Optional rejects a value that is neither ``None`` nor the inner class."""
    with pytest.raises(TypeError, match=r"str \| None, got int"):
        _optional(1)  # type: ignore[arg-type]


def test_generic_alias_accepts_origin_class() -> None:
    """A generic alias accepts an instance of its origin class."""
    assert _generic([1]) == [1]


def test_generic_alias_rejects_other_class() -> None:
    """A generic alias rejects a value that is not its origin class."""
    with pytest.raises(TypeError):
        _generic((1,))  # type: ignore[arg-type]


def test_protocol_member_in_union_is_skipped() -> None:
    """A Protocol that ``isinstance`` rejects is left unchecked, not crashed on."""
    assert _protocol_optional(5) == 5  # type: ignore[arg-type]


def test_typeddict_member_in_union_is_skipped() -> None:
    """A ``TypedDict`` that ``isinstance`` rejects is left unchecked, not crashed on."""
    assert _typeddict_optional(5) == 5  # type: ignore[arg-type]


def test_widening_applies_inside_a_union() -> None:
    """An ``int`` satisfies ``float | None``."""
    assert _float_optional(1) == 1


def test_generic_alias_inside_a_union_accepts_member_and_none() -> None:
    """``list[int] | None`` accepts a list and ``None``."""
    assert (_generic_optional([1]), _generic_optional(None)) == ([1], None)


def test_generic_alias_inside_a_union_rejects_other_class() -> None:
    """``list[int] | None`` rejects a value that is neither."""
    with pytest.raises(TypeError, match=r"list \| None"):
        _generic_optional("a")  # type: ignore[arg-type]


def test_any_member_makes_a_union_accept_anything() -> None:
    """An ``Any`` member inside a union accepts any value."""
    assert _any_member("a") == "a"


def test_literal_and_deep_elements_stay_unchecked() -> None:
    """``Literal`` values and container elements are not checked."""
    assert _unsupported(mode="zzz", values={"k": ["not-int"]}) == "zzz"  # type: ignore[arg-type]


def test_hints_resolve_once_across_calls(monkeypatch: pytest.MonkeyPatch) -> None:
    """Annotations are resolved on the first call only, not on every call."""
    list_calls: list[int] = []
    monkeypatch.setattr(
        checker_module, "_resolve_hints", lambda fn_target: list_calls.append(1) or {}
    )
    fn_checked = checker_module.type_checker(_identity)
    fn_checked(1)
    fn_checked(2)
    assert len(list_calls) == 1


@type_checker
def _probe_mixed(*, int_value: int, value: "Decimal") -> int:
    """Take one checkable and one ``TYPE_CHECKING``-only annotation.

    Parameters
    ----------
    int_value : int
        A number.
    value : 'Decimal'
        A value whose name is unavailable at runtime.

    Returns
    -------
    int
        Always 1.
    """
    return 1


def test_unavailable_annotation_does_not_disable_other_parameters() -> None:
    """A ``TYPE_CHECKING``-only name skips its own parameter, not the whole function."""
    with pytest.raises(TypeError):
        _probe_mixed(int_value="1", value=2)


class _Adder(metaclass=TypeChecker):
    """Subject class whose public methods the metaclass wraps."""

    def __init__(self, *, base: int = 10) -> None:
        self._int_base = base

    def add(self, *, value: int) -> int:
        """Add ``value`` to the base.

        Parameters
        ----------
        value : int
            The addend.

        Returns
        -------
        int
            The base plus ``value``.
        """
        return self._int_base + value

    @staticmethod
    def double(*, value: int) -> int:
        """Return twice ``value``.

        Parameters
        ----------
        value : int
            The number.

        Returns
        -------
        int
            Twice ``value``.
        """
        return value * 2

    @classmethod
    def triple(cls, *, value: int) -> int:
        """Return three times ``value``.

        Parameters
        ----------
        value : int
            The number.

        Returns
        -------
        int
            Three times ``value``.
        """
        return value * 3


def test_metaclass_accepts_right_type() -> None:
    """A well-typed call to a metaclass-wrapped method goes through."""
    assert _Adder().add(value=1) == 11


def test_metaclass_rejects_wrong_type() -> None:
    """A wrong-typed argument to a metaclass-wrapped method raises ``TypeError``."""
    with pytest.raises(TypeError):
        _Adder().add(value="1")  # type: ignore[arg-type]


def test_metaclass_staticmethod_accepts_right_type() -> None:
    """A staticmethod called with a good argument works."""
    assert _Adder.double(value=2) == 4


def test_metaclass_staticmethod_rejects_wrong_type() -> None:
    """A staticmethod called with a wrong-typed argument raises ``TypeError``."""
    with pytest.raises(TypeError):
        _Adder.double(value="2")  # type: ignore[arg-type]


def test_metaclass_classmethod_accepts_right_type() -> None:
    """A classmethod called with a good argument works."""
    assert _Adder.triple(value=2) == 6


def test_metaclass_classmethod_rejects_wrong_type() -> None:
    """A classmethod called with a wrong-typed argument raises ``TypeError``."""
    with pytest.raises(TypeError):
        _Adder.triple(value="2")  # type: ignore[arg-type]


def test_metaclass_init_accepts_right_type() -> None:
    """A constructor called with a good argument works."""
    assert _Adder(base=5).add(value=1) == 6


def test_metaclass_init_rejects_wrong_type() -> None:
    """A constructor called with a wrong-typed argument raises ``TypeError``."""
    with pytest.raises(TypeError):
        _Adder(base="5")  # type: ignore[arg-type]
