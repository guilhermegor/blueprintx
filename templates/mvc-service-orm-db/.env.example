# Environment variables for the MVC service (SQLAlchemy ORM)
#
# SCOPE: this file is the UNION of six backends' keys, so at any moment most of it is INERT
# while still reading as live configuration. Every block below names the DB_BACKEND values
# that actually read it; anything outside that scope is ignored, not wrong.
#
# Nothing here is checked at commit time. This file is only the SEED: bin/ensure_env.sh copies
# it to .env on a fresh checkout and then never touches .env again, so a machine set up months
# ago still carries its day-one values no matter how far the code moved. Assume yours is stale,
# and re-read this file whenever the backend changes.

# --- always ---------------------------------------------------------------------------
# ENV: dev or prd (also development/production/produção/etc.; case/accent/space-insensitive)
ENV=development
APP_NAME=mvc-service-orm-db

# --- always: engine selection ----------------------------------------------------------
# SQLAlchemy database backend selected by config/connection_db.py.
# Available options: sqlite, postgresql, mariadb, mysql, mssql, oracle
DB_BACKEND=sqlite

# --- DB_BACKEND=sqlite only -------------------------------------------------------------
DB_PATH=./data/app.db

# --- every backend EXCEPT sqlite ---------------------------------------------------------
# Set DB_DSN to skip the individual fields.
DB_USER=user
DB_PASSWORD=password
DB_HOST=localhost
# DB_PORT is LEFT UNSET on purpose. It is shared by six engines with different ports
# (postgresql=5432, mysql/mariadb=3306, mssql=1433, oracle=1521), so seeding any one of
# them silently points the other five at the wrong port — and a seeded wrong value beats
# the correct per-backend default the connection factory applies when this is unset.
# Set it only to override that default.
# DB_PORT="5432"
DB_NAME=app
DB_DSN=

# --- DB_BACKEND=oracle only ---------------------------------------------------------------
# Service name replaces DB_NAME.
DB_SERVICE=XEPDB1

# --- DB_BACKEND=mssql only ------------------------------------------------------------------
# ODBC driver name used to build the pyodbc connection string.
DB_ODBC_DRIVER="ODBC Driver 17 for SQL Server"
# Auth mode: "sql" (UID/PWD, default) or "aad" (Azure AD Interactive).
DB_MSSQL_AUTH=sql
# TLS options (ODBC Driver 18 defaults Encrypt=yes). Leave unset for the driver default; set
# when connecting to a server with a self-signed certificate. Accepts yes/no/true/false/1/0/
# on/off (normalised), plus driver tokens (strict/mandatory/optional).
# DB_ENCRYPT=yes
# DB_TRUST_SERVER_CERTIFICATE=yes

# --- always: debugging ------------------------------------------------------------------
# Set to true to echo SQL statements.
SQL_ECHO=false
