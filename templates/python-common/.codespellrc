[codespell]
# skip specific file types and test files with Portuguese data.
# `*-lessons.md` is a DIFFERENT class of skip from the generated artifacts above
# (htmlcov/coverage.svg/*.diff): it is a git-ignored mirror the lessons-capture workflow WRITES,
# not a build output. codespell runs pass_filenames:false over the whole tree, so without this
# skip, writing a lesson would flag the mirror and abort an unrelated staged commit. This one
# `skip` is the single source both gates read: `poe lint` scans the whole working tree while
# pre-commit scans only staged files, so they agree only because the skip lives here.
# ⚠️ Use the BASENAME glob, not `docs/*-lessons.md`: codespell matches the skip against the path
# as walked, and `poe lint` / CI invoke `codespell .`, which yields `./docs/…` — a `docs/`-anchored
# pattern silently fails to match there (verified). A basename glob is invocation-independent.
skip = *.po,*.csv,*.json,*.xml,*.txt,.git,*.pyc,__pycache__,*.egg-info,.pytest_cache,.ruff_cache,.mypy_cache,node_modules,poetry.lock,htmlcov,coverage.svg,coverage.xml,*.diff,*-lessons.md
# count the number of spelling errors
count =
# set quiet level to suppress certain messages
quiet-level = 3
# ignore specific words (global across all files)
# LOCALE EXTENSION POINT: codespell only knows English, so docs/comments written
# in another language (e.g. Portuguese: "nomes", "caracteres", "atual"...) get
# flagged as typos and BLOCK the commit at the pre-commit boundary. This seed is
# generous on purpose — a technical PT-BR doc hits these words constantly, and
# discovering them one failed-commit-at-a-time wastes a full pre-commit run each
# time. EXTEND this list with your locale's vocabulary; never `skip` a whole file
# (that hides real typos in the code identifiers there).
# ⚠️ WRITE EVERY ENTRY IN LOWERCASE. codespell lowercases the word it found before looking it
# up, so a lowercase entry covers `classe`/`Classe`/`CLASSE`, while a CAPITALISED entry matches
# only that exact casing. Measured the hard way: de-duplicating this list kept `Classe` and
# dropped `classe`, and the lowercase word was immediately flagged again. The old `Classe,classe`
# pairs were working around this — one lowercase entry replaces both.
#
# The second half of the list is COMMIT- AND DOC-PROSE vocabulary (`ser`, `vai`, `meu`,
# `sinal`, `prefere`, …) as opposed to the domain nouns above it. It is here because a
# gate that rejects at the commit-msg / pre-commit boundary costs a FULL gate run per retry,
# and these words are discovered one failed commit at a time. Keep it in sync with the
# repo-root `.codespellrc` — the two lists drifted in BOTH directions before (30 words
# missing here, 25 missing there), and the copy that ships to new projects was the stale
# one, so every scaffolded project inherited the older vocabulary.
#
# Pruned in blueprintx#197: measured, not judged — each removed entry produced ZERO
# findings when dropped and `codespell docs/ templates/ --config=.codespellrc` (root
# invocation, which also walks this file's own template tree) was re-run over the whole
# repo. A locale word this project's own docs/templates don't currently need is not
# protecting anything; extend this list again the same way — one measured word at a time
# — if a real pt-BR docstring in a generated project needs one back.
ignore-words-list = nd,fpr,strat,enty,filetest,nome,zar,fro,hsi,wege,smll,classe,erro,serie,emiss,termo,indx,atual,nomes,caracteres,caractere,prefere,meu,ser,vai,sinal,notin
