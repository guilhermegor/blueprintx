[run]
source = src/
# Guarded by bin/check_coverage_floor.py: a pattern here must never widen past
# infrastructure/ (or a whole capability named outright, like example_feature below) into
# a capability's domain/ or application/ layer — that would silently drop real logic out of
# the fail_under denominator below. See the gate's module docstring for why (blueprintx#149).
omit =
    src/chassis/*
    src/capabilities/example_feature/*
    src/capabilities/*/infrastructure/*
    src/capabilities/*/domain/enums.py
    src/app/*
    src/config/*
    src/main.py
    src/utils/*

[report]
# Single source of truth for the coverage floor — read by pytest-cov in both the
# pre-commit `coverage-check` hook and the CI coverage gate (no duplicated literal).
fail_under = 80
exclude_lines =
    pragma: no cover
    if TYPE_CHECKING:
    @abstractmethod
    \.\.\.
