{
	"version": "2.0.0",
	"//": [
		"Every command routes through bin/poe_exec.sh, never a bare `poe`. VS Code spawns",
		"tasks in a shell that may not have the project venv activated and may not carry a",
		"pipx bin dir on PATH, so a bare `poe` is exactly the invocation most likely to fail",
		"here. The wrapper resolves poe -> python -m poethepoet -> poetry poe.",
		"",
		"This file is the SINGLE SOURCE for the four service tiers. Before the poe migration",
		"they each carried their own copy and all four were byte-identical (md5 09515a32) —",
		"four copies of one file, the drift check_codespell_sync.sh exists to police.",
		"lib-minimal keeps its own, because its task set genuinely differs."
	],
	"tasks": [
		{
			"label": "init",
			"detail": "Bootstrap venv + install pre-commit hooks",
			"type": "shell",
			"command": "bash bin/poe_exec.sh init",
			"group": "build",
			"icon": { "id": "tools", "color": "terminal.ansiBlue" },
			"presentation": { "reveal": "always", "panel": "shared" },
			"problemMatcher": []
		},
		{
			"label": "run",
			"detail": "Run the project entry-point",
			"type": "shell",
			"command": "bash bin/poe_exec.sh run",
			"group": "build",
			"icon": { "id": "play", "color": "terminal.ansiGreen" },
			"presentation": { "reveal": "always", "panel": "shared" },
			"problemMatcher": []
		},
		{
			"label": "lint",
			"detail": "Run every lint gate in the order CI runs them",
			"type": "shell",
			"command": "bash bin/poe_exec.sh lint",
			"group": "test",
			"icon": { "id": "checklist", "color": "terminal.ansiYellow" },
			"presentation": { "reveal": "always", "panel": "shared" },
			"problemMatcher": []
		},
		{
			"label": "unit_tests",
			"detail": "Run unit tests",
			"type": "shell",
			"command": "bash bin/poe_exec.sh unit_tests",
			"group": { "kind": "test", "isDefault": true },
			"icon": { "id": "beaker", "color": "terminal.ansiMagenta" },
			"presentation": { "reveal": "always", "panel": "shared" },
			"problemMatcher": []
		},
		{
			"label": "test_cov",
			"detail": "Run unit tests with coverage report and badge",
			"type": "shell",
			"command": "bash bin/poe_exec.sh test_cov",
			"group": "test",
			"icon": { "id": "graph", "color": "terminal.ansiMagenta" },
			"presentation": { "reveal": "always", "panel": "shared" },
			"problemMatcher": []
		},
		{
			"label": "test_cov_report",
			"detail": "Coverage with an HTML report + per-module terminal table",
			"type": "shell",
			"command": "bash bin/poe_exec.sh test_cov_report",
			"group": "test",
			"icon": { "id": "graph", "color": "terminal.ansiMagenta" },
			"presentation": { "reveal": "always", "panel": "shared" },
			"problemMatcher": []
		},
		{
			"label": "test_cov_serve",
			"detail": "Serve the htmlcov/ coverage report at http://localhost:8000",
			"type": "shell",
			"command": "bash bin/poe_exec.sh test_cov_serve",
			"group": "test",
			"icon": { "id": "globe", "color": "terminal.ansiMagenta" },
			"presentation": { "reveal": "always", "panel": "dedicated" },
			"problemMatcher": []
		},
		{
			"label": "db_up",
			"detail": "Start Docker services, ensure schema, apply migrations",
			"type": "shell",
			"command": "bash bin/poe_exec.sh db_up",
			"group": "build",
			"icon": { "id": "database", "color": "terminal.ansiCyan" },
			"presentation": { "reveal": "always", "panel": "dedicated" },
			"problemMatcher": []
		},
		{
			"label": "db_backup",
			"detail": "Dump the database to BACKUP_STORE_PATH",
			"type": "shell",
			"command": "bash bin/poe_exec.sh db_backup",
			"group": "build",
			"icon": { "id": "save", "color": "terminal.ansiCyan" },
			"presentation": { "reveal": "always", "panel": "dedicated" },
			"problemMatcher": []
		},
		{
			"label": "db_restore",
			"detail": "Restore the database from a dump file (DUMP=<path>)",
			"type": "shell",
			"command": "DUMP='${input:dumpPath}' bash bin/poe_exec.sh db_restore",
			"group": "build",
			"icon": { "id": "history", "color": "terminal.ansiCyan" },
			"presentation": { "reveal": "always", "panel": "dedicated" },
			"problemMatcher": []
		},
		{
			"label": "get_corporate_ca",
			"detail": "Extract a TLS-proxy CA into bin/corporate_ca.pem (corporate networks)",
			"type": "shell",
			"command": "bash bin/poe_exec.sh get_corporate_ca",
			"group": "build",
			"icon": { "id": "shield", "color": "terminal.ansiBlue" },
			"presentation": { "reveal": "always", "panel": "shared" },
			"problemMatcher": []
		},
		{
			"label": "ship",
			"detail": "Package the committed main tree into dist/<name>_<ts>.zip",
			"type": "shell",
			"command": "bash bin/poe_exec.sh ship",
			"group": { "kind": "build", "isDefault": true },
			"icon": { "id": "package", "color": "terminal.ansiCyan" },
			"presentation": { "reveal": "always", "panel": "shared" },
			"problemMatcher": []
		},
		{
			"label": "new_branch (offline)",
			"detail": "Create a feat/fix branch off the default branch — offline scaffolds only",
			"type": "shell",
			"command": "bash bin/poe_exec.sh new_branch '${input:branchName}'",
			"group": "none",
			"icon": { "id": "git-branch", "color": "terminal.ansiGreen" },
			"presentation": { "reveal": "always", "panel": "shared" },
			"problemMatcher": []
		},
		{
			"label": "git_merge_to_main (offline)",
			"detail": "Merge the current clean branch into main/master and delete it — offline scaffolds only",
			"type": "shell",
			"command": "bash bin/poe_exec.sh git_merge_to_main",
			"group": "none",
			"icon": { "id": "git-merge", "color": "terminal.ansiRed" },
			"presentation": { "reveal": "always", "panel": "shared" },
			"problemMatcher": []
		},
		{
			"label": "docs_server",
			"detail": "Serve the MkDocs site locally at http://0.0.0.0:8000",
			"type": "shell",
			"command": "bash bin/poe_exec.sh docs_server",
			"group": "none",
			"icon": { "id": "book", "color": "terminal.ansiBlue" },
			"presentation": { "reveal": "always", "panel": "dedicated" },
			"problemMatcher": []
		},
		{
			"label": "help",
			"detail": "List every available poe task",
			"type": "shell",
			"command": "bash bin/poe_exec.sh",
			"group": "none",
			"icon": { "id": "question", "color": "terminal.ansiWhite" },
			"presentation": { "reveal": "always", "panel": "shared" },
			"problemMatcher": []
		}
	],
	"inputs": [
		{
			"id": "branchName",
			"type": "promptString",
			"description": "Branch name (e.g. feat/my-feature or fix/the-bug)"
		},
		{
			"id": "dumpPath",
			"type": "promptString",
			"description": "Path to the database dump file to restore"
		}
	]
}
